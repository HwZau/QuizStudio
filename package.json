{
  "name": "assignment-4-fullstack-quiz",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server && npm run build --workspace client",
    "test:e2e": "npm run build && playwright test",
    "demo": "npm run demo --workspace server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1"
  }
}
